<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>parity</groupId>
  <artifactId>parity-cc-tools</artifactId>
  <version>0.1.0</version>
  <name>parity-cc-tools</name>
  <description>parity-cc-tools: the internal ops UI (PLAN.md): tenant routing through parity-rs, service control (disable/enable as sagas), the platform health dashboard. Keycloak realm ops (local accounts + TOTP), every action audited</description>

  <properties>
    <java.version>21</java.version>
    <!-- parity-contracts (a plain sibling directory until git): the tenant-routing schemas (copied into
         the jar: every request is checked before it is sent) and the masking cases. -->
    <parity.contracts.dir>${project.basedir}/../parity-contracts</parity.contracts.dir>
    <license-maven-plugin.version>2.7.1</license-maven-plugin.version>
    <cyclonedx-maven-plugin.version>2.9.3</cyclonedx-maven-plugin.version>
    <json-schema-validator.version>3.0.8</json-schema-validator.version>
    <!-- OSV (2026-10-27, as parity-store): kafka-clients' lz4-java and snappy-java. -->
    <lz4-java.version>1.11.4</lz4-java.version>
    <snappy-java.version>1.1.10.9</snappy-java.version>
    <errorprone.version>2.50.0</errorprone.version>
    <parity-errorprone-checks.version>0.1.0</parity-errorprone-checks.version>
    <errorprone.flags>-XepDisableWarningsInGeneratedCode -XepExcludedPaths:.*/generated-(test-)?sources/.* -Xep:FutureReturnValueIgnored:ERROR -Xep:GuardedBy:ERROR -Xep:UnusedVariable:ERROR -Xep:MissingCasesInEnumSwitch:ERROR</errorprone.flags>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>at.yawk.lz4</groupId>
        <artifactId>lz4-java</artifactId>
        <version>${lz4-java.version}</version>
      </dependency>
      <dependency>
        <groupId>org.xerial.snappy</groupId>
        <artifactId>snappy-java</artifactId>
        <version>${snappy-java.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- The web UI (server-rendered: Thymeleaf + vendored HTMX), the management port. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <!-- The ops login: an OAuth2/OIDC client (a BFF: the tokens stay on the server) against the
         Keycloak realm ops; sessions in Postgres (Spring Session JDBC), stateless pods. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-session-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!-- Postgres through JdbcClient (explicit SQL), Flyway. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- parity-rs request/reply and its events: the plain client (as admin-console). -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${json-schema-validator.version}</version>
    </dependency>

    <dependency>
      <groupId>com.google.errorprone</groupId>
      <artifactId>error_prone_annotations</artifactId>
      <version>${errorprone.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-redpanda</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>parity-cc-tools</finalName>
    <resources>
      <!-- As spring-boot-starter-parent: application*.yml filtered (@project.version@), the rest as is. -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>**/application*.yml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>**/application*.yml</exclude>
        </excludes>
      </resource>
      <!-- The log event catalogue (log-record.v1): the appender's dedup reads it from the jar. -->
      <resource>
        <directory>${project.basedir}/logging</directory>
        <targetPath>logging</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>contract-files</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/contracts</outputDirectory>
              <resources>
                <resource>
                  <directory>${parity.contracts.dir}</directory>
                  <includes>
                    <include>VERSION</include>
                    <include>schemas/tenant-routing/tenant-routing-requests.v1.json</include>
                    <include>schemas/tenant-routing/tenant-routing-replies.v1.json</include>
                    <include>schemas/tenant-routing/tenant-routing-events.v1.json</include>
                    <include>masking/cases.v1.json</include>
                    <include>masking/billing.v1.json</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Static analysis as parity-store: javac's lint and Error Prone with the shared checks
           (parity-telephony-controller/tools/errorprone-checks, installed by scripts/ci.sh). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all,-processing,-serial</arg>
            <arg>-Werror</arg>
            <arg>-XDcompilePolicy=simple</arg>
            <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
            <arg>--should-stop=ifError=FLOW</arg>
            <arg>-Xplugin:ErrorProne ${errorprone.flags}</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>${errorprone.version}</version>
            </path>
            <path>
              <groupId>parity</groupId>
              <artifactId>parity-errorprone-checks</artifactId>
              <version>${parity-errorprone-checks.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs>
                <arg>-Xlint:all,-processing,-serial</arg>
                <arg>-Werror</arg>
                <arg>-XDcompilePolicy=simple</arg>
                <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                <arg>--should-stop=ifError=FLOW</arg>
                <arg>-Xplugin:ErrorProne ${errorprone.flags} -Xep:NoSynchronized:OFF -Xep:NoDataInMessages:OFF -Xep:StringSplitter:OFF</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Djdk.tracePinnedThreads=short</argLine>
          <redirectTestOutputToFile>true</redirectTestOutputToFile>
          <systemPropertyVariables>
            <parity.contracts.dir>${parity.contracts.dir}</parity.contracts.dir>
            <!-- src/test/resources/logback-test.xml: the log-record.v1 lines scripts/ci.sh checks. -->
            <parity.test.log.dir>${project.build.directory}/test-logs</parity.test.log.dir>
            <parity.test.log>unit</parity.test.log>
          </systemPropertyVariables>
          <environmentVariables>
            <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
          </environmentVariables>
        </configuration>
      </plugin>
      <!-- *IT: Postgres and Redpanda in containers, the Kubernetes and opensips stand-ins, the app on
           random ports. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <argLine>-Djdk.tracePinnedThreads=short</argLine>
          <redirectTestOutputToFile>true</redirectTestOutputToFile>
          <systemPropertyVariables>
            <cctools.jar>${project.build.directory}/${project.build.finalName}.jar</cctools.jar>
            <parity.contracts.dir>${parity.contracts.dir}</parity.contracts.dir>
            <parity.test.log.dir>${project.build.directory}/test-logs</parity.test.log.dir>
            <parity.test.log>it</parity.test.log>
          </systemPropertyVariables>
          <environmentVariables>
            <!-- Ryuk needs the docker socket inside a container, which SELinux refuses on this
                 host; each test removes its own containers, ci.sh removes leftovers by label. -->
            <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
          </environmentVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <banDuplicatePomDependencyVersions/>
                <bannedDependencies>
                  <excludes>
                    <exclude>log4j:log4j</exclude>
                    <exclude>org.apache.logging.log4j:log4j-core</exclude>
                    <exclude>org.projectlombok:lombok</exclude>
                    <!-- The Kubernetes API is reached with java.net.http (PLAN.md §0): no client library. -->
                    <exclude>io.fabric8</exclude>
                    <exclude>io.kubernetes</exclude>
                  </excludes>
                </bannedDependencies>
                <requireReleaseDeps>
                  <message>No snapshot dependencies.</message>
                </requireReleaseDeps>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <version>${cyclonedx-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>sbom</id>
            <phase>package</phase>
            <goals>
              <goal>makeBom</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <outputFormat>json</outputFormat>
          <outputName>bom</outputName>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>${license-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>licences</id>
            <phase>verify</phase>
            <goals>
              <goal>add-third-party</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <!-- Check every build: without it the goal skips when THIRD-PARTY.txt is newer than the pom. -->
          <force>true</force>
          <failOnMissing>true</failOnMissing>
          <failOnBlacklist>true</failOnBlacklist>
          <overrideUrl>file://${project.basedir}/src/license/override-THIRD-PARTY.properties</overrideUrl>
          <includedLicenses>
            <includedLicense>Apache-2.0</includedLicense>
            <includedLicense>MIT</includedLicense>
            <includedLicense>MIT-0</includedLicense>
            <includedLicense>BSD-2-Clause</includedLicense>
            <includedLicense>BSD-3-Clause</includedLicense>
            <includedLicense>EPL-1.0</includedLicense>
            <includedLicense>EPL-2.0</includedLicense>
            <includedLicense>EDL-1.0</includedLicense>
            <includedLicense>MPL-2.0</includedLicense>
            <includedLicense>CC0-1.0</includedLicense>
            <includedLicense>LGPL-2.1</includedLicense>
            <includedLicense>CDDL-1.0</includedLicense>
            <includedLicense>CDDL-1.1</includedLicense>
            <includedLicense>CDDL-GPL-CE</includedLicense>
            <includedLicense>GPL-2.0-CE</includedLicense>
          </includedLicenses>
          <licenseMerges>
            <licenseMerge>Apache-2.0|Apache License, Version 2.0|The Apache Software License, Version 2.0|Apache 2.0|Apache License 2.0|The Apache License, Version 2.0|Apache License Version 2.0|Apache Software License - Version 2.0|Apache License, version 2.0</licenseMerge>
            <licenseMerge>MIT|The MIT License|MIT License|The MIT License (MIT)|MIT license</licenseMerge>
            <licenseMerge>BSD-2-Clause|BSD 2-Clause License|The BSD 2-Clause License</licenseMerge>
            <licenseMerge>BSD-3-Clause|BSD 3-Clause License|The BSD 3-Clause License|BSD-3-Clause License</licenseMerge>
            <licenseMerge>EDL-1.0|Eclipse Distribution License - v 1.0|EDL 1.0|Eclipse Distribution License v. 1.0</licenseMerge>
            <licenseMerge>EPL-1.0|Eclipse Public License 1.0|Eclipse Public License - v 1.0</licenseMerge>
            <licenseMerge>EPL-2.0|Eclipse Public License 2.0|Eclipse Public License v2.0|Eclipse Public License - v 2.0|EPL 2.0|Eclipse Public License - Version 2.0</licenseMerge>
            <licenseMerge>MPL-2.0|Mozilla Public License 2.0|Mozilla Public License Version 2.0</licenseMerge>
            <licenseMerge>CC0-1.0|Public Domain, per Creative Commons CC0|CC0 1.0 Universal</licenseMerge>
            <licenseMerge>LGPL-2.1|GNU Lesser General Public License, Version 2.1|LGPL 2.1|LGPL-2.1-only</licenseMerge>
            <licenseMerge>CDDL-1.0|COMMON DEVELOPMENT AND DISTRIBUTION LICENSE (CDDL) Version 1.0</licenseMerge>
            <licenseMerge>CDDL-1.1|CDDL 1.1</licenseMerge>
            <licenseMerge>CDDL-GPL-CE|CDDL + GPLv2 with classpath exception|CDDL/GPLv2+CE</licenseMerge>
            <licenseMerge>GPL-2.0-CE|GPL2 w/ CPE|GNU General Public License, version 2 with the GNU Classpath Exception</licenseMerge>
          </licenseMerges>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
